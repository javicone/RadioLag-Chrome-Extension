{
  "manifest_version": 3,
  "name": "Radio Sync - Cadena SER",
  "version": "1.0",
  "description": "Reproduce la Cadena SER en cualquier página y sincronízala con el vídeo.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}