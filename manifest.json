{
  "manifest_version": 3,
  "name": "Radio Sync",
  "version": "1.0",
  "description": "Reproduce emisoras de radio en vivo en cualquier página web con control de retraso para sincronizar con contenido de vídeo.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  }
}